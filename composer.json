{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0.2",
        "anhskohbo/no-captcha": "^3.2",
        "artesaos/seotools": "^0.22.1",
        "bitfumes/laravel-multiauth": "^5.0",
        "cviebrock/eloquent-sluggable": "^9.0",
        "emotality/tawk-laravel": "^1.0",
        "fideloper/proxy": "^4.2",
        "guzzlehttp/guzzle": "^7.2",
        "jackiedo/dotenv-editor": "^1.1",
        "laravel/framework": "^9.0",
        "laravel/helpers": "^1.2",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.0",
        "laravolt/avatar": "^4.1.7",
        "maatwebsite/excel": "^3.1",
        "mckenziearts/laravel-notify": "^2.2",
        "nicolaslopezj/searchable": "1.*",
        "razorpay/razorpay": "^2.8",
        "renatomarinho/laravel-page-speed": "^2.0",
        "spatie/laravel-activitylog": "^4.0",
        "spatie/laravel-permission": "^5.5",
        "spatie/laravel-robots-middleware": "^1.3",
        "spatie/laravel-sitemap": "^6.0",
        "tzsk/payu": "^7.0",
        "yajra/laravel-datatables-buttons": "^4.13"
    },
    "require-dev": {
        "spatie/laravel-ignition": "^1.0",
        "fakerphp/faker": "^1.9.1",
        "laravel/telescope": "^4.0",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ],
        "files": [
            "app/Helpers/SterilizeRequest.php",
            "app/Helpers/SendEmail.php",
            "app/helpers.php",
            "app/federals.php",
            "app/Federal/AWLMEAPI.php",
            "app/Federal/ReqMsgDTO.php",
            "app/Federal/VtransactSecurity.php",
            "app/Federal/ResMsgDTO.php"
            
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
